{
  "name": "kstreams-ts",
  "version": "0.1.0",
  "description": "Partition-aware stateful stream processing on Kafka for Node.js, with fault-tolerant state and exactly-once processing.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "CONTEXT.md",
    "CHANGELOG.md",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:crash": "vitest run --config vitest.crash.config.ts",
    "kafka": "scripts/kafka-local.sh",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@platformatic/kafka": "2.14.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "kafka",
    "stream-processing",
    "kafka-streams",
    "exactly-once",
    "typescript"
  ]
}
